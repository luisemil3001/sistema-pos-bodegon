    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  },
  "config": {
    "forge": {
      "packagerConfig": {
